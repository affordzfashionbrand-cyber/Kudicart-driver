# KudiCart Driver App — Production Environment Example
# Copy to .env.production locally (never commit real secrets or keystores).

# Backend REST API base URL (DCR-012)
VITE_API_BASE_URL=https://api.affordz.com/api/v1

# Google Maps Platform Android SDK API Key (D-021)
# Injected into AndroidManifest.xml via android/app/build.gradle manifestPlaceholders
GOOGLE_MAPS_API_KEY=replace_with_android_maps_api_key

# Sentry Error Tracking DSN (D-023)
SENTRY_DSN=replace_with_sentry_dsn
VITE_SENTRY_DSN=replace_with_sentry_dsn

# Release Android signing keystore (configure via Gradle properties / CI secrets; never commit keystores)
# KUDICART_UPLOAD_STORE_FILE=
# KUDICART_UPLOAD_KEY_ALIAS=
# KUDICART_UPLOAD_STORE_PASSWORD=
# KUDICART_UPLOAD_KEY_PASSWORD=

# Firebase Cloud Messaging / Auth (D-017, D-019):
# Place client-owned android/app/google-services.json locally (gitignored).
